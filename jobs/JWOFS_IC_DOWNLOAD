: "${INIT_TIME:?INIT_TIME must be defined}"

export WORK_DIR="${WORK_DIR:-${DATAROOT}/WoF_IC/hrrrdas/${INIT_TIME}}"

mkdir -p "${WORK_DIR}"

echo "=============================================================="
