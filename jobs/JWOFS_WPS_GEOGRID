#!/bin/bash

set -euo pipefail

export TZ=UTC

: "${HOMEwofs:?HOMEwofs is required}"
: "${DATAROOT:?DATAROOT is required}"
: "${CDATE:?CDATE is required}"
: "${region:?region is required}"

[[ "$CDATE" =~ ^[0-9]{10}$ ]] || exit 1
[[ "$region" =~ ^[A-Za-z0-9_-]+$ ]] || exit 1

export PDY="${CDATE:0:8}"
export cyc="${CDATE:8:2}"

export EXECwofs="$HOMEwofs/exec"
export FIXwofs="$HOMEwofs/fix"
export PARMwofs="$HOMEwofs/parm"
export USHwofs="$HOMEwofs/ush"
export SCRIPTwofs="$HOMEwofs/scripts"

export COMROOT="${COMROOT:-$DATAROOT/com/wofs/v1.0}"

export COMOUT="$COMROOT/wofs.${PDY}/${cyc}"

export COMOUT_DOMAIN="$COMOUT/$region"

export WPS_COM_DIR="$COMOUT_DOMAIN/WPS"

export COMOUT_GEOGRID="$WPS_COM_DIR/GEOGRID"

export DOMAIN_CONFIG="$COMOUT_DOMAIN/realtime.cfg.${PDY}.${region}"

export WPS_CONFIG="${WPS_CONFIG:-$PARMwofs/wps/config.yaml}"

export SENDCOM="${SENDCOM:-YES}"
export KEEPDATA="${KEEPDATA:-NO}"

WORK_ROOT="$DATAROOT/wps/${CDATE}/${region}"

mkdir -p "$WORK_ROOT"

export DATA="$(mktemp -d "$WORK_ROOT/geogrid.XXXXXXXX")"

if [[ ! -s "$DOMAIN_CONFIG" ]]; then
    echo "[ERROR] Missing domain configuration:"
    echo "$DOMAIN_CONFIG"
    exit 1
fi

if [[ ! -x "$EXECwofs/geogrid.exe" ]]; then
    echo "[ERROR] Missing geogrid.exe"
    exit 1
fi

echo "===== WoFS GEOGRID ====="
echo "CDATE       : $CDATE"
echo "Region      : $region"
echo "DATA        : $DATA"
echo "COMOUT      : $COMOUT_GEOGRID"

cd "$DATA"

"$SCRIPTwofs/exwofs_wps_geogrid.sh"

if [[ "$KEEPDATA" == "NO" ]]; then
    cd "$WORK_ROOT"
    rm -rf -- "$DATA"
fi

echo "[SUCCESS] GEOGRID completed for $region"
