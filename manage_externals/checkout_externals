#!/usr/bin/env python3
"""
WoFS v1.0 external source code management utility.

Read Externals.cfg and check out the configured Git revisions.

Usage:
    ./manage_externals/checkout_externals
    ./manage_externals/checkout_externals --status
    ./manage_externals/checkout_externals WRF WPS
"""

import argparse
import configparser
import subprocess
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
CONFIG = ROOT / "Externals.cfg"


def run_git(args, cwd=None, capture=False):
    result = subprocess.run(
        ["git", *args],
        cwd=cwd,
        check=True,
        text=True,
        stdout=subprocess.PIPE if capture else None,
    )

    return result.stdout.strip() if capture else None


def load_config():
    config = configparser.ConfigParser(interpolation=None)

    if not config.read(CONFIG):
        raise RuntimeError(f"Cannot read {CONFIG}")

    return config


def process_external(name, section, status_only=False):

    protocol = section.get("protocol", "git")
    url = section["repo_url"]
    revision = section["hash"]
    target = ROOT / section["local_path"]

    if protocol != "git":
        raise RuntimeError(f"{name}: Unsupported protocol {protocol}")

    if not target.resolve().is_relative_to(ROOT):
        raise RuntimeError(f"{name}: Invalid local path")

    print(f"\n===== {name} =====", flush=True)
    print(f"Repository: {url}", flush=True)
    print(f"Revision:   {revision}", flush=True)
    print(f"Directory:  {target}", flush=True)

    if target.is_symlink():
        raise RuntimeError(f"{name}: Source directory is a symbolic link")

    if not target.exists():

        if status_only:
            print("[MISSING] Source code not downloaded")
            return False

        target.parent.mkdir(parents=True, exist_ok=True)

        run_git([
            "clone",
            "--no-checkout",
            url,
            str(target),
        ])

        run_git(
            ["checkout", "--detach", revision],
            cwd=target,
        )

    else:

        if not (target / ".git").exists():
            raise RuntimeError(f"{target} is not a Git repository")

        remote = run_git(
            ["remote", "get-url", "origin"],
            cwd=target,
            capture=True,
        )

        if remote != url:
            raise RuntimeError(
                f"{name}: Unexpected origin URL: {remote}"
            )

        current = run_git(
            ["rev-parse", "HEAD"],
            cwd=target,
            capture=True,
        )

        changes = run_git(
            ["status", "--porcelain"],
            cwd=target,
            capture=True,
        )

        if changes:
            print("[WARNING] Local source changes detected")

            if status_only:
                return False

            raise RuntimeError(
                f"{name}: Refusing to modify a dirty repository"
            )

        if current == revision:
            print(f"[PASS] Already at required revision: {current}")
            return True

        if status_only:
            print(f"[MISMATCH] Current revision: {current}")
            return False

        run_git(["fetch", "origin"], cwd=target)

        run_git(
            ["checkout", "--detach", revision],
            cwd=target,
        )

    actual = run_git(
        ["rev-parse", "HEAD"],
        cwd=target,
        capture=True,
    )

    if actual != revision:
        raise RuntimeError(
            f"{name}: Revision mismatch: {actual}"
        )

    print(f"[PASS] Checked out {actual}")

    return True


def main():

    parser = argparse.ArgumentParser(
        description="WoFS external source code management"
    )

    parser.add_argument(
        "--status",
        action="store_true",
        help="Report external source status without modifying files",
    )

    parser.add_argument(
        "components",
        nargs="*",
        help="External components to process",
    )

    args = parser.parse_args()

    config = load_config()

    available = [
        name for name in config.sections()
        if name != "externals_description"
    ]

    selected = args.components or [
        name for name in available
        if config[name].getboolean("required", fallback=True)
    ]

    unknown = set(selected) - set(available)

    if unknown:
        parser.error(
            "Unknown components: " + ", ".join(sorted(unknown))
        )

    print(f"WoFS repository: {ROOT}", flush=True)
    print(f"Configuration:   {CONFIG}", flush=True)

    results = []

    for name in selected:
        try:
            success = process_external(
                name,
                config[name],
                status_only=args.status,
            )
        except Exception as exc:
            print(f"[ERROR] {name}: {exc}", file=sys.stderr)
            success = False

        results.append((name, success))

    print("\n===== External source summary =====")

    for name, success in results:
        print(f"{name:12s} {'PASS' if success else 'NOT READY'}")

    return 0 if all(success for _, success in results) else 1


if __name__ == "__main__":
    sys.exit(main())
