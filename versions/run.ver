#!/bin/bash
#
# WoFS v1.0 - Runtime Versions
# NCO EE2-style version definitions
#

export wofs_ver=v1.0.0
export wofs_component=ic_prep

export wofs_modulefile=ursa_ic_prep

# Intel runtime environment
export stack_oneapi_ver=2024.2.1
export stack_impi_ver=2021.13

# Supporting libraries
export jasper_ver=2.0.32
export libpng_ver=1.6.37

# IC_PREP Python dependencies
export python_ver=3.11
export pyyaml_ver=6.0.2

# GRIB2 utilities
export wgrib2_ver=3.1.3_wmo

# NetCDF and HDF5
export netcdf_c_ver=4.9.2
export netcdf_fortran_ver=4.6.1
export hdf5_ver=1.14.3

# Postprocessing utilities
export nco_ver=5.2.4
export ncl_ver=6.6.2

# NCEP libraries
export crtm_ver=2.4.0.1
export g2_ver=3.5.1
export g2c_ver=2.1.0
