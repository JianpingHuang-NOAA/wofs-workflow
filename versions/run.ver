#!/bin/bash
#
# WoFS v1.0 - Runtime Versions
# NCO EE2-style version definitions
#

export wofs_ver=v1.0.0
export wofs_component=ic_prep

export wofs_modulefile=ursa_ic_prep

# Intel runtime environment
export stack_oneapi_ver=2024.2.1
export stack_impi_ver=2021.13

# Native Ursa compiler and MPI runtime
export intel_compiler_ver=2023.2.0
export intel_mpi_ver=2021.13.1

# Supporting libraries
export jasper_ver=2.0.32
export libpng_ver=1.6.37

# Shared WoFS Python runtime
export python_ver=3.11
export pyyaml_ver=6.0.2

# Additional shared WoFS Python dependencies
export numpy_ver=2.2.5
export netcdf4_python_ver=1.7.4
export scipy_ver=1.15.2
export pyproj_ver=3.7.2
export pygrib_ver=2.1.8
export eccodes_ver=2.44.0
export python_patch_ver=3.11.12
export cftime_ver=1.6.5
export packaging_ver=25.0
export certifi_ver=2025.4.26

# Native libraries reported by Python packages
export python_proj_ver=9.5.1
export python_netcdf_ver=4.9.3
export python_hdf5_ver=1.14.6

# GRIB2 utilities
export wgrib2_ver=3.1.3_wmo

# NetCDF and HDF5
export netcdf_c_ver=4.9.2
export netcdf_fortran_ver=4.6.1
export hdf5_ver=1.14.3
export parallel_netcdf_ver=1.12.3

# Postprocessing utilities
export nco_ver=5.2.4
export ncl_ver=6.6.2

# NCEP libraries
export crtm_ver=2.4.0.1
export g2_ver=3.5.1
export g2c_ver=2.1.0

# ============================================================
# Isolated UPP runtime environment on NOAA Ursa
# ============================================================

export upp_modulefile=ursa_upp
export spack_stack_ver=1.9.2

# DOMAIN_SETUP geographical and plotting dependencies
export matplotlib_ver=3.10.1
export cartopy_ver=0.25.0
export shapely_ver=2.1.2
export pyshp_ver=2.3.1
